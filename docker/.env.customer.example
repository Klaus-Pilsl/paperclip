# ----------------------------------------------------------------------------
# Paperclip Customer Deployment — Environment File
#
# Kopiere diese Datei nach ./.env (im Repo-Root) und trage Werte ein:
#   cp docker/.env.customer.example .env
# ----------------------------------------------------------------------------

# Pflicht: zufaelliger 32-Byte-Hex-String. Einmalig generieren, danach NICHT mehr aendern,
# sonst werden alle bestehenden Sessions ungueltig.
# Erzeugen mit:  openssl rand -hex 32
BETTER_AUTH_SECRET=

# Pflicht: URL, unter der die UI erreichbar ist (Schema + Hostname/IP + Port).
# Diese URL muss von allen Clients erreichbar sein, sonst schlagen Login-Callbacks
# und Bootstrap-Invite-Links fehl.
# Beispiele:
#   http://paperclip.lan:3100
#   http://192.168.1.50:3100
#   http://server.tailnet-name.ts.net:3100
PAPERCLIP_PUBLIC_URL=

# Optional: Host-Port-Mapping. Default 3100. Falls 3100 belegt ist, hier aendern
# und PAPERCLIP_PUBLIC_URL entsprechend anpassen.
PAPERCLIP_PORT=3100

# ----------------------------------------------------------------------------
# API-Keys fuer LLM-Provider
#
# Mindestens ein Key ist sinnvoll. Alternativ koennen Keys spaeter auch
# direkt in der UI unter Settings hinterlegt werden.
# ----------------------------------------------------------------------------

# OpenRouter (https://openrouter.ai) — Zugang zu 300+ Modellen ueber einen Key.
OPENROUTER_API_KEY=

# OpenAI direkt
OPENAI_API_KEY=

# Anthropic direkt
ANTHROPIC_API_KEY=
